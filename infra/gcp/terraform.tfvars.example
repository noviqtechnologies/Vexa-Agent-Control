# ─── Google Cloud Deployment Configuration Example ───────────────────────────
# Copy this file to terraform.tfvars or use terraform.stage.tfvars:
#   Windows (PowerShell): Copy-Item terraform.stage.tfvars terraform.tfvars
#   Linux / macOS:        cp terraform.stage.tfvars terraform.tfvars

# Target Google Cloud Project ID
gcp_project_id = "vexa-prod"

# GCP region (e.g. europe-west1, us-central1, asia-east1)
gcp_region = "europe-west1"

# Deployment environment identifier (stage, dev, prod)
environment = "stage"

# Container Images (defaults to latest official releases or Artifact Registry images)
container_image         = "ghcr.io/noviqtechnologies/agentcontrol:latest"
control_plane_ui_image  = "ghcr.io/noviqtechnologies/agentcontrol-dashboard-frontend:latest"
control_plane_api_image = "ghcr.io/noviqtechnologies/agentcontrol-dashboard-api:latest"
control_plane_db_image  = "ghcr.io/noviqtechnologies/agentcontrol-db:latest"

# Sizing & Scaling (Cost-Optimized Scale-to-Zero: ~$0–$2/month for Stage)
min_instances  = 0       # Set to 0 for stage/dev scale-to-zero ($0 idle compute)
max_instances  = 3
gateway_cpu    = "1"
gateway_memory = "512Mi"
api_cpu        = "1"
api_memory     = "256Mi"
ui_cpu         = "1"
ui_memory      = "256Mi"
db_cpu         = "1"
db_memory      = "256Mi"

# Access Control & Protection
allow_unauthenticated = true
deletion_protection   = false

# Networking: Set to true only if custom enterprise VPC and Serverless Connector are required
enable_vpc     = false
# vpc_cidr       = "10.10.0.0/16"
# connector_cidr = "10.10.8.0/28"

# Private Container Registry (GAR): Automated retention policy keeps latest 2 tags
gar_enabled = true

# Secrets (Leave blank to automatically generate secure random tokens)
# gateway_secret     = "your-custom-gateway-secret-token"
# policy_read_secret = "your-custom-policy-read-secret"
# encryption_secret  = "0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
# session_secret     = "your-custom-session-signing-secret"
# postgres_password  = "your-custom-db-password"

# Custom Google Cloud Labels
labels = {
  project     = "agentcontrol"
  environment = "stage"
  managed_by  = "terraform"
}
