server {
    listen 80;
    listen 8081;
    root /usr/share/nginx/html;
    index index.html;

    # SPA fallback — all routes serve index.html, React Router handles them.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Proxy API requests to dashboard-api.
    # The upstream host:port is resolved from the AGENTCONTROL_API_UPSTREAM environment
    # variable at container startup via nginx:alpine envsubst templating.
    #
    #   ECS Fargate (shared network namespace)  → default 127.0.0.1:8400
    #   Docker Compose (per-service namespace)  → dashboard-api:8400  (set in compose file)
    #
    # NGINX_ENVSUBST_FILTER=AGENTCONTROL_ ensures only AGENTCONTROL_* variables are
    # substituted so NGINX's own runtime variables ($uri, $host, $remote_addr, etc.)
    # pass through unchanged.
    location /api/ {
        proxy_pass http://${AGENTCONTROL_API_UPSTREAM};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        # SSE support for /api/v1/alerts/stream.
        proxy_set_header Connection '';
        proxy_buffering off;
        proxy_cache off;
        chunked_transfer_encoding off;
    }

    # Security headers.
    add_header X-Frame-Options DENY always;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://* https://*" always;

    # Cache static assets aggressively (Vite hashes filenames).
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
