# FR-401 / NFR-302: Hardened Agent Container Runtime (HAR)
# Multi-stage OCI-compliant Dockerfile producing a <100MB image with Agent Control entrypoint proxy.

# Build Stage
FROM rust:1.85-alpine as builder
WORKDIR /usr/src/agentcontrol
RUN apk add --no-libc-dev build-base pkgconfig openssl-dev
COPY . .
RUN cargo build --release --bin agentcontrol

# Runtime Stage (Alpine based for <100MB footprint)
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /usr/src/agentcontrol/target/release/agentcontrol /usr/local/bin/agentcontrol

# Auto-configuration environment variables
ENV AGENTCONTROL_LISTEN="0.0.0.0:8080"
ENV AGENTCONTROL_POLICY_PATH="/etc/agentcontrol/agentcontrol-policy.yaml"

EXPOSE 8080

ENTRYPOINT ["agentcontrol", "start"]
