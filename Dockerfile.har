# FR-401 / NFR-302: Hardened Agent Container Runtime (HAR)
# Multi-stage OCI-compliant Dockerfile producing a <100MB image with AgentWall entrypoint proxy.

# Build Stage
FROM rust:1.89-alpine as builder
WORKDIR /usr/src/agentwall
RUN apk add --no-libc-dev build-base pkgconfig openssl-dev
COPY . .
RUN cargo build --release --bin agentwall

# Runtime Stage (Alpine based for <100MB footprint)
FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata
WORKDIR /app
COPY --from=builder /usr/src/agentwall/target/release/agentwall /usr/local/bin/agentwall

# Auto-configuration environment variables
ENV AGENTWALL_LISTEN="0.0.0.0:8080"
ENV AGENTWALL_POLICY_PATH="/etc/agentwall/agentwall-policy.yaml"

EXPOSE 8080

ENTRYPOINT ["agentwall", "start"]
