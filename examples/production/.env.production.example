# ══════════════════════════════════════════════════════════════════════════════
# VEXA AGENT CONTROL — PRODUCTION ENVIRONMENT SECRETS TEMPLATE
# ══════════════════════════════════════════════════════════════════════════════
# All fields below are strictly REQUIRED in production mode.
# Generate strong secrets with: openssl rand -hex 32
# ══════════════════════════════════════════════════════════════════════════════

# ── Domain & Ingress ──────────────────────────────────────────────────────────
HUB_DOMAIN=hub.yourdomain.com
INGRESS_AUTH_SECRET=replace-with-openssl-rand-hex-32

# ── PostgreSQL Database ───────────────────────────────────────────────────────
POSTGRES_USER=vexa_admin
POSTGRES_PASSWORD=replace-with-strong-db-password-32chars
POSTGRES_DB=vexa_control_plane

# ── Internal Service Tokens & Encryption Keys ────────────────────────────────
# 256-bit hexadecimal string (64 characters) for AES key encryption
PROVIDER_KEY_ENCRYPTION_SECRET=replace-with-64-character-hex-string-from-openssl-rand-hex-32

# Internal service-to-service secrets
GATEWAY_SECRET=replace-with-openssl-rand-hex-32
POLICY_READ_SECRET=replace-with-openssl-rand-hex-32
AGENTCONTROL_SESSION_SECRET=replace-with-openssl-rand-hex-32

# ── Initial Platform Administrator ───────────────────────────────────────────
SAAS_OPERATOR_EMAIL=security-admin@yourdomain.com
SAAS_OPERATOR_PASSWORD=replace-with-strong-unique-operator-password
