# Vexa Agent Control — Local Development Environment Configuration
# Explicitly set DEV_MODE to true for local testing and mock services.
DEV_MODE=true
ALLOW_DEV_MODE=true

# Gateway Configuration
AGENTCONTROL_LISTEN=0.0.0.0:8080
AGENTCONTROL_LOG_PATH=/var/log/agentcontrol/audit.log
AGENTCONTROL_DRY_RUN=false

# Secrets (Automatically generated for dev if left empty)
POLICY_READ_SECRET=dev-ephemeral-policy-read-secret
GATEWAY_SECRET=dev-ephemeral-gateway-secret
SIEM_TOKEN=mock-splunk-token-for-local-dev
