# ─── Stage 1: Build AgentWall Gateway (Rust) ─────────────────────────────────
FROM rust:1.89-slim-bookworm AS rust-builder
WORKDIR /build
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/build/target \
    cargo build --release --bin agentwall && \
    cp /build/target/release/agentwall /usr/local/bin/agentwall

# ─── Stage 2: Build Dashboard Frontend (Node) ────────────────────────────────
FROM node:20-alpine AS node-builder
WORKDIR /app
COPY dashboard/frontend/package.json dashboard/frontend/package-lock.json* ./
RUN npm install
COPY dashboard/frontend .
RUN npm run build

# ─── Stage 3: Build Dashboard API (Go) ───────────────────────────────────────
FROM golang:1.22-alpine AS go-builder
WORKDIR /src
COPY dashboard/api/go.mod dashboard/api/go.sum ./
RUN go mod download
COPY dashboard/api .
RUN CGO_ENABLED=0 go build -o /dashboard-api .

# ─── Stage 4: Final Image (Postgres + Dashboard + Gateway) ───────────────────
FROM debian:bookworm-slim
WORKDIR /app

# Install PostgreSQL, Nginx, Supervisor, and CA certs
RUN apt-get update && apt-get install -y \
    postgresql postgresql-contrib \
    nginx \
    supervisor \
    ca-certificates \
    curl \
    jq \
    && rm -rf /var/lib/apt/lists/*

# Copy Binaries and Assets
COPY --from=rust-builder /usr/local/bin/agentwall /usr/local/bin/agentwall
COPY --from=go-builder /dashboard-api /usr/local/bin/dashboard-api
COPY --from=node-builder /app/dist /usr/share/nginx/html

# Copy configurations and scripts
RUN rm -f /etc/nginx/sites-enabled/default
COPY dashboard/frontend/nginx.conf /etc/nginx/conf.d/default.conf
COPY dashboard/db/migrations /app/migrations
COPY policy.example.yaml /app/policy.example.yaml
COPY start-standalone.sh /app/start-standalone.sh

RUN chmod +x /app/start-standalone.sh

# Create directories for logs and DB
RUN mkdir -p /var/log/agentwall /var/log/supervisor /run/postgresql && \
    chown -R postgres:postgres /run/postgresql && \
    chmod 755 /var/log/agentwall

# Environment defaults
ENV AGENTWALL_LISTEN=0.0.0.0:8080 \
    AGENTWALL_LOG_PATH=/var/log/agentwall/audit.log \
    DATABASE_URL=postgres://agentwall:agentwall@127.0.0.1:5432/agentwall?sslmode=disable \
    DASHBOARD_PORT=8400 \
    GATEWAY_URL=http://127.0.0.1:8080

EXPOSE 80 8080 8400

ENTRYPOINT ["/app/start-standalone.sh"]
