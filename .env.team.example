# ==============================================================================
# Vexa Agent Control — Small Team Hub Environment Configuration (.env)
# ==============================================================================
# Instructions:
# 1. Copy this template: cp .env.team.example .env
# 2. Generate secure random secrets using OpenSSL or Python:
#      openssl rand -hex 32
# 3. Fill in all required values below before running docker compose.
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=vexa
POSTGRES_DB=vexa_control_plane
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# Gateway Shared Secret (used for gateway-to-hub telemetry ingest)
# Minimum 16 characters, cryptographically random. Generate: openssl rand -hex 24
GATEWAY_SECRET=

# Policy Synchronization & Self-Healing Secret
# Minimum 16 characters. Generate: openssl rand -hex 24
POLICY_READ_SECRET=

# Master AES-256-GCM Key for encrypting provider credentials at rest
# MUST be exactly 64 hex characters (32 bytes). Generate: openssl rand -hex 32
PROVIDER_KEY_ENCRYPTION_SECRET=

# Dashboard Cookie Signing & Session Secret
# Minimum 32 characters. Generate: openssl rand -hex 32
AGENTCONTROL_SESSION_SECRET=

# SaaS / Team Super-Admin Operator Credentials
SAAS_OPERATOR_EMAIL=admin@yourcompany.com
# Strong initial operator password (minimum 12 characters)
SAAS_OPERATOR_PASSWORD=

# Ingress VPC Shared Secret (Mandatory in production when running behind reverse proxy / ALB / Caddy)
# Minimum 16 characters. Generate: openssl rand -hex 24
INGRESS_AUTH_SECRET=

# Optional Vexa Hub License Key (leave empty for Community 10-seat mode)
AGENTCONTROL_HUB_LICENSE_KEY=

# Set DEV_MODE=false in all production environments
DEV_MODE=false
ALLOW_DEV_MODE=false
HUB_DOMAIN=hub.yourcompany.com

# Legacy Single-Tenant Compatibility (Optional — for migrating older 1-tenant setups)
# If LEGACY_SINGLE_TENANT_MODE=true, LEGACY_TENANT_ID is required in production.
# LEGACY_SINGLE_TENANT_MODE=false
# LEGACY_TENANT_ID=00000000-0000-0000-0000-000000000001

# Host Port Mappings (Optional overrides for local Docker dev)
# GATEWAY_PORT=18080
# LEGACY_GATEWAY_PORT=8080
# CONTROL_PLANE_API_PORT=8081
# CONTROL_PLANE_UI_PORT=3000
# POSTGRES_PORT=5432


