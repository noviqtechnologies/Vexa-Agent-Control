{
    admin off
}

{$HUB_DOMAIN:localhost} {
    encode gzip zstd

    tls {
        client_auth {
            mode request
        }
    }

    # Route API and device requests directly to Control Plane API with Ingress Secret and Client Cert headers
    handle /api/* {
        reverse_proxy control-plane-api:8081 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up X-VPC-Ingress-Auth {$INGRESS_AUTH_SECRET}
            header_up X-Client-Cert-Present {http.request.tls.client.serial}
            header_up X-Client-Cert-Serial {http.request.tls.client.serial}
            header_up X-Client-Cert-SHA256 {http.request.tls.client.fingerprint}
        }
    }

    handle /healthz {
        reverse_proxy control-plane-api:8081
    }

    # Route all UI and frontend routes to Web Console
    handle {
        reverse_proxy control-plane-ui:80 {
            header_up Host {host}
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
        }
    }
}
