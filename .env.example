# ==============================================================================
# Vexa Agent Control — Docker & Local Environment Configuration (.env)
# ==============================================================================
# Instructions:
# 1. Copy this template: cp .env.example .env
# 2. For local evaluation, default values in docker-compose.team.yml work out-of-the-box.
# 3. For custom or production deployments, generate secure random secrets:
#      openssl rand -hex 24 (for secrets & passwords)
#      openssl rand -hex 32 (for encryption keys & session tokens)
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_USER=vexa
POSTGRES_DB=vexa_control_plane
POSTGRES_PASSWORD=devpassword

# Gateway Shared Secret (used for gateway-to-hub telemetry ingest)
# Minimum 16 characters, cryptographically random. Generate: openssl rand -hex 24
GATEWAY_SECRET=local-dev-gateway-secret-1234

# Policy Synchronization & Self-Healing Secret
# Minimum 16 characters. Generate: openssl rand -hex 24
POLICY_READ_SECRET=local-dev-policy-read-secret

# Master AES-256-GCM Key for encrypting provider credentials at rest
# MUST be exactly 64 hex characters (32 bytes). Generate: openssl rand -hex 32
PROVIDER_KEY_ENCRYPTION_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Dashboard Cookie Signing & Session Secret
# Minimum 32 characters. Generate: openssl rand -hex 32
AGENTCONTROL_SESSION_SECRET=local-dev-session-secret-32-chars-long-123456

# SaaS / Team Super-Admin Operator Credentials
SAAS_OPERATOR_EMAIL=admin@vexa.local
# Strong initial operator password (minimum 12 characters in production)
SAAS_OPERATOR_PASSWORD=admin12345678

# Ingress VPC Shared Secret (Mandatory in production when running behind reverse proxy / ALB / Caddy)
INGRESS_AUTH_SECRET=

# Development Mode Controls
# Set DEV_MODE=false and ALLOW_DEV_MODE=false in production environments
DEV_MODE=true
ALLOW_DEV_MODE=true
HUB_DOMAIN=localhost

# Optional Vexa Hub License Key (leave empty for Community mode)
AGENTCONTROL_HUB_LICENSE_KEY=

# Legacy Single-Tenant Compatibility (Optional)
LEGACY_SINGLE_TENANT_MODE=true
LEGACY_TENANT_ID=00000000-0000-0000-0000-000000000001
